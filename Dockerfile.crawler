FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install deps first — cached unless pyproject.toml changes.
# A stub __init__.py lets setuptools resolve the package without real source.
COPY pyproject.toml ./
RUN mkdir -p motorcycle_parts_watcher && touch motorcycle_parts_watcher/__init__.py && \
    pip install --no-cache-dir "." && \
    playwright install chromium --with-deps && \
    rm -rf /var/lib/apt/lists/*

# Copy real source (overwrites stub; deps layer above stays cached)
COPY motorcycle_parts_watcher/ ./motorcycle_parts_watcher/
COPY alembic/ ./alembic/
COPY alembic.ini ./
RUN pip install --no-cache-dir --no-deps "."

ENTRYPOINT ["parts-watch"]
