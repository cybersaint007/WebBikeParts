DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bike_parts_watcher
DB_SCHEMA=watcher

EBAY_ENABLED=true
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Comma-separated overrides EBAY_MARKETPLACE_ID. Supported: EBAY_US, EBAY_GB, EBAY_DE,
# EBAY_AU, EBAY_IT, EBAY_FR, EBAY_ES, EBAY_CA, EBAY_JP, EBAY_NL, EBAY_BE, etc.
EBAY_MARKETPLACE_IDS=EBAY_US,EBAY_GB,EBAY_DE,EBAY_AU,EBAY_IT

YAHOO_AUCTIONS_ENABLED=false
WEBIKE_ENABLED=false
MANUAL_SEARCH_ENABLED=true

# Japanese sources — most are stubs explaining what's needed; see adapters/*.py for details.
WEBIKE_JP_ENABLED=false   # geo-redirected from non-JP IPs; needs JP egress
CROOOOBER_ENABLED=false   # public catalog dead; no working URL
MERCARI_ENABLED=false     # SPA; needs Playwright or DPoP-signed API
RAKUTEN_ENABLED=false     # Akamai-blocked; switch to official API + APP_ID
RAKUTEN_APP_ID=
MONOTARO_ENABLED=false    # works (titles/images only; prices via JS)
GOOBIKE_ENABLED=false     # SPA; needs Playwright

HTTP_TIMEOUT_SECONDS=20
HTTP_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1
HTTP_RATE_LIMIT_PER_SECOND=3

DEFAULT_CURRENCY=USD
