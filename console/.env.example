APP_NAME="Motorcycle Parts Watcher"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgresql
DB_PORT=5432
DB_DATABASE=bike_parts_watcher
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=console

# Watcher schema connection (read by RunPartsWatchJob subprocess env override)
WATCHER_DB_HOST=postgresql
WATCHER_DB_PORT=5432
WATCHER_DB_DATABASE=bike_parts_watcher
WATCHER_DB_USERNAME=
WATCHER_DB_PASSWORD=
WATCHER_DB_SCHEMA=watcher

QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

EBAY_VERIFICATION_TOKEN=
