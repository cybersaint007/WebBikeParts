FROM php:8.4-fpm-alpine

RUN apk add --no-cache \
    postgresql-dev \
    libzip-dev \
    icu-dev \
    oniguruma-dev \
    libxml2-dev \
    unzip \
    python3 \
    py3-pip

RUN docker-php-ext-install \
    pdo_pgsql \
    pgsql \
    mbstring \
    xml \
    bcmath \
    intl \
    zip \
    opcache

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install parts-watch CLI so the queue/scheduler workers can shell out to it.
# playwright has no musl/Alpine wheel and is not needed here — the queue only
# enqueues jobs to watcher.crawl_jobs; the crawler container handles scraping.
RUN python3 -m venv /opt/parts-watch && \
    /opt/parts-watch/bin/pip install --no-cache-dir \
        "alembic>=1.13.2" "beautifulsoup4>=4.12.3" "httpx>=0.27.0" \
        "jinja2>=3.1.4" "lxml>=5.2.2" "psycopg[binary]>=3.2.1" \
        "pydantic>=2.8.2" "python-dotenv>=1.0.1" "rich>=13.7.1" \
        "sqlalchemy>=2.0.32" "typer>=0.12.3"

COPY pyproject.toml /build/pyproject.toml
COPY motorcycle_parts_watcher/ /build/motorcycle_parts_watcher/
RUN /opt/parts-watch/bin/pip install --no-cache-dir --no-deps /build && \
    rm -rf /root/.cache/pip /build

ENV WATCHER_PARTS_WATCH_BIN=/opt/parts-watch/bin/parts-watch

WORKDIR /var/www/html

COPY docker/php/zz-docker.conf /usr/local/etc/php-fpm.d/zz-docker.conf
COPY docker/entrypoint-console.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm", "-F"]
